# Copy this file to ".env" and fill in real values.
# ".env" is ignored by git and must never be committed.

# SQLAlchemy connection string (required).
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/price_comparison

# Flask session/CSRF key (required). Use a long random string.
SECRET_KEY=replace-with-a-long-random-string

# ntfy topic for error notifications (optional).
NOTIFIER=your-ntfy-topic
